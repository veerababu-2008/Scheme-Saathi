# ============================================================
# SchemeSaathi AI — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database (MySQL 8) ---
DATABASE_URL=mysql+pymysql://schemesaathi:password@localhost:3306/schemesaathi_dev
# For production (Aiven / Railway):
# DATABASE_URL=mysql+pymysql://user:pass@host:port/dbname?ssl_ca=/path/ca.pem

# --- JWT ---
JWT_SECRET_KEY=change-me-to-another-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRES=900         # 15 minutes (seconds)
JWT_REFRESH_TOKEN_EXPIRES=2592000    # 30 days (seconds)
JWT_COOKIE_SECURE=false              # Set true in production (HTTPS)
JWT_COOKIE_SAMESITE=Lax

# --- Google Gemini API ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- FAISS ---
FAISS_INDEX_PATH=../data/vector_index/faiss.idx
FAISS_METADATA_PATH=../data/vector_index/metadata.json

# --- RAG Settings ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=6

# --- Rate Limiting ---
RATELIMIT_DEFAULT=60/minute
RATELIMIT_AUTH=5/minute
RATELIMIT_CHAT=20/minute

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# --- Admin ---
ADMIN_INITIAL_EMAIL=admin@schemesaathi.in
ADMIN_INITIAL_PASSWORD=change-me-on-first-login
